<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/home_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="8dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/app_name" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorPrimary"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/about" style="?attr/materialIconButtonStyle" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/about" app:icon="@drawable/ic_info"/>
 </LinearLayout>
 <TextView android:id="@+id/home_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_title" android:textAppearance="@style/AppTitle" android:layout_marginTop="12dp"/>
 <TextView android:id="@+id/home_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_body" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="8dp"/>
 <TextView android:id="@+id/phone_language_home" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorPrimary" android:accessibilityLiveRegion="polite"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/access_status" style="?attr/materialButtonTonalStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" app:icon="@drawable/ic_check"/>
 <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/search_apps" style="@style/LanguageSearch" app:startIconDrawable="@drawable/ic_search" app:endIconMode="clear_text">
  <com.google.android.material.textfield.TextInputEditText android:id="@+id/search_apps" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:imeOptions="actionDone" android:maxLines="1"/>
 </com.google.android.material.textfield.TextInputLayout>
 <LinearLayout android:id="@+id/filter_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
  <TextView android:id="@+id/app_count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/loading_apps" android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?attr/colorOnSurfaceVariant"/>
  <com.google.android.material.chip.Chip android:id="@+id/show_all" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/show_all" android:checkable="true" app:ensureMinTouchTargetSize="true"/>
 </LinearLayout>
 <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
   <com.google.android.material.chip.Chip android:id="@+id/favorites_only" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Favorites" android:checkable="true" app:ensureMinTouchTargetSize="true"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/select_apps" android:layout_marginStart="8dp" style="?attr/materialButtonTonalStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select apps" android:minHeight="48dp"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/app_actions" android:layout_marginStart="8dp" style="?attr/materialButtonTonalStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Actions" android:minHeight="48dp"/>
  </LinearLayout>
 </HorizontalScrollView>
 <TextView android:id="@+id/operation_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
 <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/action_progress" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone"/>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/app_list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="16dp"/>
  <TextView android:id="@+id/empty_apps" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="32dp" android:text="@string/no_apps_detail" android:textAppearance="?attr/textAppearanceBodyLarge" android:visibility="gone"/>
 </FrameLayout>
</LinearLayout>
