  </LinearLayout>
  <com.google.android.material.button.MaterialButton android:id="@+id/app_favorite" style="?attr/materialIconButtonStyle" android:layout_width="48dp" android:layout_height="48dp" app:icon="@drawable/ic_star_outline"/>
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
